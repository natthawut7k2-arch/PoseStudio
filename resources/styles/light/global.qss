/**
 * @file light/global.qss
 * @brief Light theme: primary application stylesheet for PoseStudio (Light + Green).
 *
 * Mirrors the dark global.qss selector-for-selector — same widgets, same radii,
 * same cascade position (loaded first). The palette features an eye-friendly,
 * calming light+green aesthetic: soft sage-tinted foundations (#f2f5f3), pure white
 * panels (#ffffff), deep charcoal-forest text (#1e2621), refreshing forest green
 * accents (#2e7d4f), and deep forest selection fill (#275a3c). Checked checkboxes
 * paint the green accent BEHIND the white check glyph (check.png).
 */

/* ========================================================================= */
/* [ APPLICATION ROOT ]                                                      */
/* ========================================================================= */

QMainWindow {
    /* Base application background (Light + Green Theme Foundation - soft sage tint) */
    background-color: #f2f5f3;
}

QLabel {
    color: #1e2621;
    font-size: 18px;
    padding: 4px;
}

/* ========================================================================= */
/* [ SPLITTERS (RESIZABLE PANELS) ]                                          */
/* ========================================================================= */

QSplitter::handle {
    /* Clear separation between main UI panels */
    background-color: #b8c7bb;
}

QSplitter::handle:horizontal {
    width: 5px;
    border-left: 1px solid #a3b5a6;
    border-right: 1px solid #a3b5a6;
}

QSplitter::handle:vertical {
    height: 5px;
    border-top: 1px solid #a3b5a6;
    border-bottom: 1px solid #a3b5a6;
}

/* --- Splitter Interactions --- */

QSplitter::handle:hover {
    /* Darken the handle so the user knows it can be dragged */
    background-color: #7d9683;
}

QSplitter::handle:pressed {
    /* Primary green highlight when actively resizing */
    background-color: #2e7d4f;
}

/* ========================================================================= */
/* [ SIDEBAR TABS (QTabWidget) ]                                             */
/* ========================================================================= */

QTabWidget::pane {
    /* Flat container panel with a clean border */
    border: 1px solid #cad4cc;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e2e8e3;
    color: #47554b;
    padding: 12px 6px;

    /* Establish the boundary between unselected tabs */
    border: 1px solid #b8c7bb;
    border-right: none;

    /* Soften the outer edge (assumes West-aligned tabs) */
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 2px;
}

/* --- Tab Interactions --- */

QTabBar::tab:selected {
    /* Active tab with green accent border indicator */
    background-color: #ffffff;
    color: #1e2621;
    border: 1px solid #cad4cc;
    border-right: none;
    border-left: 3px solid #2e7d4f;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    /* Clear highlight for inactive tabs when moused over */
    background-color: #edf3ee;
    color: #1e2621;
}

/* ========================================================================= */
/* [ TOOLTIPS ]                                                              */
/* ========================================================================= */
QToolTip {
    background-color: #ffffff; /* Matches the light panel surfaces */
    color: #1e2621;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 13px;
}

/* ========================================================================= */
/* [ CHECKBOXES ]                                                            */
/* ========================================================================= */
/* ONE indicator app-wide: a light well with the green hover accent; checked = the white
   check glyph on the forest green fill. */
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #a3b5a6;
    border-radius: 3px;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #2e7d4f; /* Green accent */
}

QCheckBox::indicator:checked {
    background: #2e7d4f;
    image: url(:/resources/icons/check.png);
}

/* ========================================================================= */
/* [ DIALOGS (QMessageBox, etc.) ]                                          */
/* ========================================================================= */

QDialog {
    background-color: #f2f5f3;
}

QMessageBox QLabel {
    /* Overrides the global dark QLabel color above with a softer tone, */
    /* and drops the 18px default size that's sized for the main window. */
    color: #334036;
    font-size: 13px;
}

QDialog QPushButton {
    background-color: #ffffff;
    color: #1e2621;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QDialog QPushButton:hover {
    background-color: #ebefe9;
}

QDialog QPushButton:pressed {
    background-color: #2e7d4f;
    color: #ffffff;
}

QDialog QPushButton:default {
    /* Highlights whichever button Enter/Return will trigger */
    border: 1px solid #2e7d4f;
}

/* ========================================================================= */
/* [ SCROLLBARS ]                                                            */
/* ========================================================================= */

QScrollBar:vertical {
    width: 14px;
    margin: 0px;
    background-color: #ebefe9;
    border: none;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    margin: 2px;
    background-color: #b8c5ba;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #93a295;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
