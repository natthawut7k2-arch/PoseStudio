/**
 * @file light/_assetmanager.qss
 * @brief Light theme: the Asset Manager tab (src/assets/*).
 *
 * Mirror of the dark _assetmanager.qss. Grid thumbnails themselves keep their dark
 * canvas (Constants::COLOR_THUMB_BG_*) so artwork previews read identically; only the
 * surrounding chrome goes light. Selection fill uses deep forest green #275a3c with white text,
 * and grid selection wash uses soft mint #dcf0e2 with accent border #2e7d4f.
 */

/* =========================================================================
   [ TOP PANEL & HEADER ]
   ========================================================================= */

#AssetManagerTopPanel {
    background-color: #ffffff;
    border-radius: 4px;
}

#AssetManagerTitle {
    padding: 10px;
    color: #334036;
    font-size: 14px;
    font-weight: bold;
}

/* =========================================================================
   [ SEARCH BAR ]
   ========================================================================= */

#AssetManagerSearchRow {
    background-color: #ffffff;
}

#AssetManagerSearchInput {
    background-color: #ffffff;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    color: #1e2621;
    padding: 3px 6px;
    font-size: 12px;
    selection-background-color: #275a3c;
    selection-color: #ffffff;
}

#AssetManagerSearchInput:focus {
    border: 1px solid #2e7d4f;
    outline: none;
}

#AssetManagerClearButton,
#AssetManagerSearchButton {
    background-color: #edf2ee;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    padding: 0px;
}

#AssetManagerClearButton:hover,
#AssetManagerSearchButton:hover {
    background-color: #e1e9e2;
}

#AssetManagerClearButton:pressed,
#AssetManagerSearchButton:pressed {
    background-color: #2e7d4f;
    border-color: #2e7d4f;
}

#AssetManagerSearchSeparator {
    /* The app-wide separator grey (Constants::COLOR_SEPARATOR). */
    color: #6a6b6e;
    background-color: #6a6b6e;
    max-height: 1px;
    border: none;
}

/* =========================================================================
   [ DIRECTORY TREE ]
   ========================================================================= */

#AssetManagerTree {
    /* The app-wide separator grey (Constants::COLOR_SEPARATOR, QMenu::separator in
       _menumanager.qss), injected into the C++ delegate's separator rows via Q_PROPERTY. */
    qproperty-separatorColor: #6a6b6e;
    padding: 4px;
    background-color: #ffffff;
    border: none;
    border-radius: 4px;
    outline: none; /* Removes the dotted focus ring */
    color: #334036;
}

#AssetManagerTree::item {
    padding: 4px;
}

#AssetManagerTree::item:hover {
    background-color: #ebf5ee;
}

#AssetManagerTree::item:selected {
    background-color: #275a3c;
    color: #ffffff;
}

/* =========================================================================
   [ ASSET GRID ]
   ========================================================================= */

#AssetManagerGrid {
    padding: 8px;
    background-color: #f2f5f3;
    border: 1px solid #cad4cc;
    border-radius: 4px;
    outline: none;
}

#AssetManagerGrid::item {
    padding: 4px;
    background-color: transparent;
    border: 1px solid transparent; /* This prevents the 1px jitter! */
    border-radius: 6px;
    color: #556258;
}

#AssetManagerGrid::item:hover {
    background-color: #ffffff;
    border: 1px solid #b8c7bb;
    color: #1e2621;
}

#AssetManagerGrid::item:selected {
    background-color: #dcf0e2; /* Soft mint selection wash */
    border: 1px solid #2e7d4f; /* Green accent border */
    color: #1e2621;
}

/* =========================================================================
   [ INFO BAR FOOTER ]
   ========================================================================= */

#AssetManagerInfoBar {
    padding: 0px 4px 8px 12px;
    color: #556258;
    font-size: 12px;
}

#AssetManagerAddLibraryHint {
    font-size: 14px;
}

/* ========================================================================= */
/* ASSET MANAGER CONTEXT MENU                                                */
/* ========================================================================= */

QMenu#AssetManagerContextMenu {
    border: 1px solid #b8c7bb;
    background-color: #ffffff; /* Matches the light theme */
    icon-size: 12px;
}

QMenu#AssetManagerContextMenu::item {
    padding: 5px 25px 5px 10px;
    color: #1e2621;
}

QMenu#AssetManagerContextMenu::item:selected {
    background-color: #ebf5ee; /* Highlight color on hover */
}

QMenu#AssetManagerContextMenu::icon {
    padding-left: 12px;
}

/* Separators: the global QMenu::separator rule (_menumanager.qss) — one colour app-wide. */

QMenu#AssetManagerContextMenu::item:disabled {
    color: #93a096; /* Muted, greyed-out text */
    background-color: transparent; /* Ensures it doesn't highlight on hover */
}
