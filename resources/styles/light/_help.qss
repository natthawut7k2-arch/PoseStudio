/**
 * @file light/_help.qss
 * @brief Light theme: the User Manual window (src/help/helpwindow.cpp) — toolbar,
 *        contents tree and page browser.
 *
 * Mirror of the dark _help.qss. The PAGE's own typography (heading colours, links, code,
 * tables) is not QSS — HelpManual::render sets it (helpmanual.cpp), which branches on
 * AppTheme::isLightTheme(); only the browser's body text colour, background and font
 * come from here. Keep the two in step.
 */

/* =========================================================================
   [ WINDOW + TOOLBAR ]
   ========================================================================= */

#HelpWindow {
    background-color: #f2f5f3;
}

#HelpToolbar {
    background-color: #f2f5f3;
    border-bottom: 1px solid #d5ded7;
}

#HelpBack, #HelpForward {
    background-color: #ffffff;
    color: #1e2621;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    padding: 4px 12px;
}

#HelpBack:hover, #HelpForward:hover {
    background-color: #ebefe9;
}

#HelpBack:pressed, #HelpForward:pressed {
    background-color: #2e7d4f;
    color: #ffffff;
}

#HelpBack:disabled, #HelpForward:disabled {
    color: #93a096;
    border-color: #cad4cc;
    background-color: #e3e9e4;
}

#HelpSearch {
    background-color: #ffffff;
    color: #1e2621;
    border: 1px solid #b8c7bb;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #275a3c;
    selection-color: #ffffff;
}

#HelpSearch:hover {
    border-color: #a3b5a6;
}

#HelpSearch:focus {
    border-color: #2e7d4f;
}

/* =========================================================================
   [ CONTENTS TREE ]  — the Preferences nav's look: an accent bar marks the page shown
   ========================================================================= */

#HelpToc {
    background-color: #f2f5f3;
    border: none;
    outline: 0;
    padding-top: 6px;
    font-size: 13px;
}

#HelpToc::item {
    color: #556258;
    padding: 5px 6px;
    border-left: 3px solid transparent;
}

#HelpToc::item:hover {
    background-color: #e3e9e4;
    color: #1e2621;
}

#HelpToc::item:selected {
    background-color: #ffffff;
    color: #1e2621;
    border-left: 3px solid #275a3c;
}

#HelpToc::branch {
    background-color: #f2f5f3;
}

#HelpToc::branch:has-children:closed {
    image: url(:/resources/icons/expand.png);
}

#HelpToc::branch:has-children:open {
    image: url(:/resources/icons/collapse.png);
}

/* =========================================================================
   [ PAGE BROWSER ]
   ========================================================================= */

#HelpBrowser {
    background-color: #ffffff;
    color: #202822;
    border: none;
    font-size: 14px;
    selection-background-color: #275a3c;
    selection-color: #ffffff;
}

#HelpSplitter::handle {
    background-color: #d5ded7;
}
